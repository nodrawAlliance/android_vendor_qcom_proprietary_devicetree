#include "sapphiren-pinctrl.dtsi"
#include "xiaomi-sm6225-common.dtsi"

&soc {
	onewire_gpio: onewire_gpio {
		compatible = "xiaomi,onewire_gpio";
		label = "xm_onewire";
		xiaomi,version = <1>;
		xiaomi,ow_gpio = <&tlmm 66 0x00>;
		xiaomi,gpio_number = <66>;
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&onewire_gpio_active>;
		pinctrl-1 = <&onewire_gpio_sleep>;
		status = "ok";
	};

	maxim_ds28e30: maxim_ds28e30 {
		status = "ok";
		#io-channel-cells = <1>;
		compatible = "maxim,ds28e30";
		label = "max_ds28e30";
		maxim,version = <1>;
	};

	acl_slg: acl_slg {
		compatible = "acl,slg";
		status = "okay";
		def-supply = <&maxim_ds28e30>;
	};

	st_stick: st_stick {
		compatible = "st,stick";
		status = "okay";
		def-supply = <&maxim_ds28e30 &acl_slg>;
	};

	auth_battery: auth_battery {
		compatible = "lc,auth-battery";
		status = "okay";
		#io-channel-cells = <1>;
		def-supply = <&maxim_ds28e30 &acl_slg &st_stick>;
	};

	xm_smart_chg {
		compatible = "xiaomi,xm_smart_chg";
		status = "ok";
		label = "smart_charging";
        xiaomi,pd-thermal-mitigation      = <5950000 5400000 5000000 4500000
                                            4000000 3700000 3500000 3000000
                                            2800000 2500000 2000000 1500000
                                            1000000 800000 500000 350000
                                            800000 800000>;

        xiaomi,pd-thermal-mitigation-fast = <6000000 5950000 5950000 5400000
                                            5000000 4500000 4000000 3700000
                                            2800000 2500000 2000000 1500000
                                            1000000 800000 500000 350000
                                            800000 800000>;
		io-channels = <&pm7250b_qg 66>,
		              <&pm7250b_charger 4>,
					  <&pm7250b_qg 67>;
		io-channel-names = "capacity", "pd_active", "capacity_raw";
	};

	fingerprint_xiaomi {
		status = "okay";
		compatible = "xiaomi,xiaomi-fp";
		xiaomi,gpio_irq = <&tlmm 83 0x00>;
		vfp-supply = <&pm6125_l9>;
		netlink-event = <29>;
		fp-gpio-pwr = <&tlmm 65 0x00>;
		pinctrl-names = "reset_high", "reset_low",
		                "eint_default", "eint_pulldown",
						"pwr_high", "pwr_low";
		pinctrl-0 = <&fingerprints_reset_high>;
		pinctrl-1 = <&fingerprints_reset_low>;
		pinctrl-2 = <&fingerprints_eint_default>;
		pinctrl-3 = <&fingerprints_eint_pulldown>;
		pinctrl-4 = <&fingerprints_pwr_high>;
		pinctrl-5 = <&fingerprints_pwr_low>;
	};
};

&qupv3_se1_i2c {
    status = "ok";
	qcom,bus-recovery;
	sc8541@6a {
		compatible = "sc,sc8541-standalone";
		status = "ok";
		dep-supply = <&qupv3_se1_i2c>;
		#io-channel-cells = <1>;
		reg = <0x6a>;
		sc8541,intr_gpio = <&tlmm 84 0x00>;
		charger_name = "primary_dvchg";
		sc,sc8541,vbat-ovp-dis = <0>;
		sc,sc8541,vbat-ovp = <90>;
		sc,sc8541,vbat-ovp-alm-dis = <1>;
		sc,sc8541,vbat-ovp-alm = <70>;
		sc,sc8541,ibat-ocp-dis = <0>;
		sc,sc8541,ibat-ocp = <81>;
		sc,sc8541,ibat-ocp-alm-dis = <1>;
		sc,sc8541,ibat-ocp-alm = <80>;
		sc,sc8541,ibus-ucp-dis = <0>;
		sc,sc8541,vbus-in-range-dis = <0>;
		sc,sc8541,vbus-pd-en = <0>;
		sc,sc8541,vbus-ovp = <100>;
		sc,sc8541,vbus-ovp-alm-dis = <1>;
		sc,sc8541,vbus-ovp-alm = <80>;
		sc,sc8541,ibus-ocp-dis = <0>;
		sc,sc8541,ibus-ocp = <13>;
		sc,sc8541,tshut-dis = <1>;
		sc,sc8541,tsbus-flt-dis = <1>;
		sc,sc8541,tsbat-flt-dis = <1>;
		sc,sc8541,tdie-alm = <200>;
		sc,sc8541,tsbus-flt = <21>;
		sc,sc8541,tsbat-flt = <21>;
		sc,sc8541,vac1-ovp = <3>;
		sc,sc8541,vac2-ovp = <3>;
		sc,sc8541,vac1-pd-en = <0>;
		sc,sc8541,vac2-pd-en = <0>;
		sc,sc8541,fsw-set = <4>;
		sc,sc8541,wd-timeout = <0>;
		sc,sc8541,wd-timeout-dis = <1>;
		sc,sc8541,ibat-sns-r = <0>;
		sc,sc8541,ss-timeout = <7>;
		sc,sc8541,ibus-ucp-fall-dg = <1>;
		sc,sc8541,vout-ovp-dis = <0>;
		sc,sc8541,ms = <0>;
		sc,sc8541,vout-ovp = <3>;
		sc,sc8541,pmid2out-uvp = <7>;
		sc,sc8541,pmid2out-ovp = <7>;
	};

	bq25960@65 {
		compatible = "bq,bq25960-standalone";
		#io-channel-cells = <1>;
		status = "ok";
		dep-supply = <&qupv3_se1_i2c>;
		reg = <0x65>;
		bq25960,intr_gpio = <&tlmm 84 0x00>;
		charger_name = "primary_dvchg";
		bq,bq25960,vbat-ovp-dis = <0>;
		bq,bq25960,vbat-ovp = <127>;
		bq,bq25960,vbat-ovp-alm-dis = <1>;
		bq,bq25960,vbat-ovp-alm = <122>;
		bq,bq25960,ibat-ocp-dis = <0>;
		bq,bq25960,ibat-ocp = <61>;
		bq,bq25960,ibat-ocp-alm-dis = <1>;
		bq,bq25960,ibat-ocp-alm = <61>;
		bq,bq25960,ibus-ucp-dis = <0>;
		bq,bq25960,ibus-ucp = <0>;
		bq,bq25960,chg-config-2 = <0>;
		bq,bq25960,vbus-pd-en = <0>;
		bq,bq25960,vbus-ovp = <100>;
		bq,bq25960,vbus-ovp-alm-dis = <0>;
		bq,bq25960,vbus-ovp-alm = <100>;
		bq,bq25960,ibus-ocp = <13>;
		bq,bq25960,tsbus-flt-dis = <1>;
		bq,bq25960,tsbat-flt-dis = <1>;
		bq,bq25960,tdie-alm = <200>;
		bq,bq25960,tsbus-flt = <21>;
		bq,bq25960,tsbat-flt = <21>;
		bq,bq25960,vac1-ovp = <3>;
		bq,bq25960,vac2-ovp = <3>;
		bq,bq25960,vac1-pd-en = <0>;
		bq,bq25960,vac2-pd-en = <0>;
		bq,bq25960,fsw-set = <4>;
		bq,bq25960,wd-timeout = <0>;
		bq,bq25960,wd-timeout-dis = <1>;
		bq,bq25960,ibat-sns-r = <0>;
		bq,bq25960,ss-timeout = <5>;
		bq,bq25960,ibus-ucp-fall-dg = <1>;
		bq,bq25960,vout-ovp-dis = <0>;
		bq,bq25960,ms = <0>;
		bq,bq25960,vout-ovp = <3>;
	};
};
